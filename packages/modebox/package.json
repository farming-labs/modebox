{
  "name": "modebox",
  "version": "0.2.0",
  "description": "Run agent-written JavaScript/TypeScript in a snapshot-able WebAssembly sandbox (Rust + wasmtime + QuickJS)",
  "keywords": [
    "sandbox",
    "wasm",
    "javascript",
    "ai-agents",
    "mcp",
    "code-mode"
  ],
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./run": {
      "types": "./run.d.ts",
      "default": "./run.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "run.mjs",
    "run.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "modebox-darwin-arm64": "0.2.0",
    "modebox-darwin-x64": "0.2.0",
    "modebox-linux-x64-gnu": "0.2.0",
    "modebox-linux-arm64-gnu": "0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/modebox.git",
    "directory": "packages/modebox"
  },
  "homepage": "https://github.com/farming-labs/modebox",
  "bugs": "https://github.com/farming-labs/modebox/issues",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
